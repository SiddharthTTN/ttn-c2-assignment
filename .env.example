# Copy to `.env` for local docker-compose and postgres profile runs.
# Use placeholder values only — replace in your private environment; never commit `.env`.

# HTTP port for Spring Boot (default 8080)
PORT=8080

# PostgreSQL (matches docker-compose service defaults)
DATABASE_URL=jdbc:postgresql://localhost:5432/support_tickets
DATABASE_USERNAME=support
DATABASE_PASSWORD=change-me-local-db-password

# Ollama (Spring AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Spring profile: h2 (demo) | postgres (production stack)
SPRING_PROFILES_ACTIVE=h2
