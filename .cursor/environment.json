{
  "name": "Grounded Support Tickets",
  "install": "bash .cursor/scripts/cloud-agent-install.sh",
  "start": "bash .cursor/scripts/cloud-agent-start.sh",
  "terminals": [
    {
      "name": "backend-h2",
      "command": "make run-h2"
    },
    {
      "name": "frontend",
      "command": "cd frontend && npm run dev -- --host 0.0.0.0 --port 5173"
    }
  ],
  "ports": [
    {
      "name": "api",
      "port": 8080
    },
    {
      "name": "frontend",
      "port": 5173
    }
  ]
}
